# Required for LLM chat (unless LLM_MOCK=true)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: real market data via Massive; empty = built-in simulator
MASSIVE_API_KEY=

# Optional: "true" for deterministic mock LLM responses
LLM_MOCK=false

# Optional: override the LLM. Unset = openrouter/openai/gpt-oss-120b via Cerebras.
# Free-tier example (no credits needed, rate limited):
# LLM_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
